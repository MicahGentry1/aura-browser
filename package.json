{
  "name": "aura-chromium-browser",
  "version": "1.0.2",
  "description": "Modern desktop web browser powered by the Chromium rendering engine",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-packager . \"Aura Browser\" --platform=win32 --arch=x64 --out=dist --overwrite",
    "dist:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.aurabrowser.app",
    "productName": "Aura Browser",
    "publish": {
      "provider": "github",
      "owner": "MicahGentry1",
      "repo": "aura-browser"
    },
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!dist-installer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aura Browser",
      "artifactName": "AuraBrowserSetup.exe"
    }
  },
  "keywords": [
    "browser",
    "chromium",
    "electron",
    "web"
  ],
  "author": "Antigravity AI",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "electron-winstaller": "^5.4.4"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9"
  }
}
